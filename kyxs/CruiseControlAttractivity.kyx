Theorem "Automatic cruise controller: attractivity"
/*
 * Generated from hybrid automaton
 * subgraph CruiseController
 * ebrakeact("v' = -t-2.5, x' = 0, t' = 1
 *       & 15 <= v & v <= 40
 *       & 0 <= t & t <= 2.5")
 * ebrakefull("v' = -5, x' = 0, t' = 0
 *       & 15 <= v & v <= 40
 *       & t = 2.5")
 * sbrakeact("v' = -t-1.2, x' = 0, t' = 0.5
 *       & 5 <= v & v <= 20
 *       & 0 <= t & t <= 1.3")
 * sbrakefull("v' = -2.5, x' = 0, t' = 0
 *       & 5 <= v & v <= 20
 *       & t = 1.3")
 * normalPI("v' = -0.001*x-0.052*v, x' = v, t' = 0
 *       & -15 <= v & v <= 15
 *       & -500 <= x & x <= 500")
 * accelerate("v' = 1.5, x' = 0, t' = 0
 *       & -20 <= v & v <= -5 ")
 *
 * ebrakeact -->|"?(15 <= v & v <= 40 & t = 2.5);"| ebrakefull
 * ebrakeact -->|"?(15 <= v & v <= 16 & 0 <= t & t <= 2.5); t:=0;"| sbrakeact
 *
 * ebrakefull -->|"?(15 <= v & v <= 16 & t = 2.5); t:=0;"| sbrakeact
 *
 * sbrakeact -->|"?(18 <= v & v <= 20 & 0 <= t & t <= 1.3); t:=0;"| ebrakeact
 * sbrakeact -->|"?(5 <= v & v <= 20 & t = 1.3);"| sbrakefull
 * sbrakeact -->|"?(5 <= v & v <= 11 & 0 <= t & t <= 1.3); x:=0;"| normalPI
 *
 * sbrakefull -->|"?(18 <= v & v <= 20 & t = 1.3); t:=0;"| ebrakeact
 * sbrakefull -->|"?(5 <= v & v <= 11 & t = 1.3); x:=0;"| normalPI
 *
 * normalPI -->|"?(13 <= v & v <= 15 & -500 <= x & x <= 500); t:=0;"| sbrakeact
 * normalPI -->|"?(-15 <= v & v <= -14 & -500 <= x & x <= 500);"| accelerate
 *
 * accelerate -->|"?(-6 <= v & v <= -5 & -500 <= x & x <= 500); x:=0;"| normalPI
 *
 * end
 *
 * Init("t:=0; x:=0;") --> CruiseController
 */

Definitions
  Real accelerate = 0;
  Real ebrakeact = 1;
  Real ebrakefull = 2;
  Real normalPI = 3;
  Real sbrakeact = 4;
  Real sbrakefull = 5;
End.

ProgramVariables
  Real x;
  Real t;
  Real v;
  Real mode;
End.

Problem
  \forall eps
    (
      eps > 0 ->
      \forall del
        (
          del > 0 ->
          \exists T_
            (
              T_ >= 0 &
                \forall v
                    (
                      v^2 < del^2 ->
                      [
                        t_:=0;
                        {
                          {
                            mode:=ebrakeact();
                            ++
                            mode:=ebrakefull();
                            ++
                            mode:=sbrakeact();
                            ++
                            mode:=sbrakefull();
                            ++
                            mode:=normalPI(); ++ mode:=accelerate();
                          }
                          t:=0; x:=0;
                        }
                        {
                          {
                            ?mode = ebrakeact();
                            {
                              ?15 <= v & v <= 40 & t = 2.5; mode:=ebrakefull();
                              ++
                              {?15 <= v & v <= 16 & 0 <= t & t <= 2.5; t:=0;}
                              mode:=sbrakeact();
                              ++
                              mode:=mode;
                            }
                            ++
                            ?mode = ebrakefull();
                            {
                              {?15 <= v & v <= 16 & t = 2.5; t:=0;}
                              mode:=sbrakeact();
                              ++
                              mode:=mode;
                            }
                            ++
                            ?mode = sbrakeact();
                            {
                              {?18 <= v & v <= 20 & 0 <= t & t <= 1.3; t:=0;}
                              mode:=ebrakeact();
                              ++
                              ?5 <= v & v <= 20 & t = 1.3; mode:=sbrakefull();
                              ++
                              {?5 <= v & v <= 11 & 0 <= t & t <= 1.3; x:=0;}
                              mode:=normalPI();
                              ++
                              mode:=mode;
                            }
                            ++
                            ?mode = sbrakefull();
                            {
                              {?18 <= v & v <= 20 & t = 1.3; t:=0;}
                              mode:=ebrakeact();
                              ++
                              {?5 <= v & v <= 11 & t = 1.3; x:=0;}
                              mode:=normalPI();
                              ++
                              mode:=mode;
                            }
                            ++
                            ?mode = normalPI();
                            {
                              {?13 <= v & v <= 15 & (-500) <= x & x <= 500; t:=0;}
                              mode:=sbrakeact();
                              ++
                              ?(-15) <= v & v <= (-14) & (-500) <= x & x <= 500;
                              mode:=accelerate();
                              ++
                              mode:=mode;
                            }
                            ++
                            ?mode = accelerate();
                            {
                              {
                                ?(-6) <= v & v <= (-5) & (-500) <= x & x <= 500;
                                x:=0;
                              }
                              mode:=normalPI();
                              ++
                              mode:=mode;
                            }
                          }
                          {
                            ?mode = ebrakeact();
                            {
                              t_'=1,
                              v'=-t - 2.5,
                              x'=0,
                              t'=1 &
                              15 <= v & v <= 40 & 0 <= t & t <= 2.5
                            }
                            ++
                            ?mode = ebrakefull();
                            {
                              t_'=1,
                              v'=(-5),
                              x'=0,
                              t'=0 &
                              15 <= v & v <= 40 & t = 2.5
                            }
                            ++
                            ?mode = sbrakeact();
                            {
                              t_'=1,
                              v'=-t - 1.2,
                              x'=0,
                              t'=0.5 &
                              5 <= v & v <= 20 & 0 <= t & t <= 1.3
                            }
                            ++
                            ?mode = sbrakefull();
                            {
                              t_'=1,
                              v'=(-2.5),
                              x'=0,
                              t'=0 &
                              5 <= v & v <= 20 & t = 1.3
                            }
                            ++
                            ?mode = normalPI();
                            {
                              t_'=1,
                              v'=(-0.001) * x - 0.052 * v,
                              x'=v,
                              t'=0 &
                              (-15) <= v & v <= 15 & (-500) <= x & x <= 500
                            }
                            ++
                            ?mode = accelerate();
                            {t_'=1, v'=1.5, x'=0, t'=0 & (-20) <= v & v <= (-5)}
                          }
                        }*
                      ]
                        (t_ >= T_ -> v^2 < eps^2)
                    )
            )
        )
    )
End.